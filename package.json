{
  "name": "beyond-the-gray-fog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original occult roguelike deckbuilding prototype and evidence-based APK research tools",
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:python": "python -m unittest discover -s tests -p 'test_*.py' -v",
    "smoke": "node tools/browser-smoke.mjs",
    "lore:build": "python tools/lore_index.py build --manifest lore/sources.json --output .local/lore-index.json",
    "check": "npm test && npm run test:python && npm run build"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
